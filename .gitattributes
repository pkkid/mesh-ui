# Text files are stored and checked out with LF on every OS.
* text=auto eol=lf

# Windows batch files need CRLF to run reliably under cmd.exe.
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary assets: never diff or convert.
*.png binary
*.ico binary
*.icns binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.woff binary
*.woff2 binary
